# Copy to .env.local for local development. On Vercel these go in Settings › Environment Variables.

# Postgres connection string. Added for you when you connect a Neon database from Vercel's Storage tab.
DATABASE_URL=

# The password for the dashboard's login screen. Make it long.
DASHBOARD_PASSCODE=

# Optional. A random string of 32+ characters used to sign login cookies.
# Without it the signing key is derived from the two values above.
AUTH_SECRET=

# ---------------- AI (optional; add any you want) ----------------
# Easiest: ONE OpenRouter key runs every model (Claude, ChatGPT, Gemini, Perplexity). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Or each company's own key. When both are set, the company's own key is used for its models.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
